{
  "name": "Anime1 Sync",
  "version": "1.27",
  "manifest_version": 3,
  "key": "",
  "description": "Track and hide Anime1 titles with Supabase SSO",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "https://nkqujduwuxulmqioezej.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://anime1.me/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Anime1 Extension",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
