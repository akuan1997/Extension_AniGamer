{
  "name": "Anime1 Sync",
  "version": "1.2",
  "manifest_version": 3,
  "description": "Track and hide Anime1 titles with Supabase SSO",
  "permissions": [
    "storage",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "https://nkqujduwuxulmqioezej.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://anime1.me/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Anime1 Extension",
    "default_popup": "index.html"
  }
}
